system foo;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (94, 94), (267, 140) */
    -- Text area for declarations and comments
    
    use dv comment 'datamodel.asn';
    /* CIF ENDTEXT */
    block foo;
        /* CIF PROCESS (420, 255), (150, 75) */
        /* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
        process foo;
            /* CIF Keep Specific Geode Partition 'default' */
            /* CIF TEXT (631, 578), (267, 140) */
            -- Text area for declarations and comments
            
            synonym
               otherTrue SomeBool = TruE;
            /* CIF ENDTEXT */
            /* CIF Keep Specific Geode Partition 'default' */
            /* CIF TEXT (778, 220), (258, 140) */
            -- The code generator shall only generate
            -- the code of one branch of each decision
            select if (c_false = true);
            procedure foo;
            endprocedure;
            endselect;
            /* CIF ENDTEXT */
            /* CIF START (321, 200), (70, 35) */
            START;
                /* CIF alternative (321, 255), (70, 50) */
                alternative c_false;
                    /* CIF ANSWER (251, 325), (70, 23) */
                    (true):
                        /* CIF PROCEDURECALL (215, 368), (142, 35) */
                        call writeln('ERROR (1)');
                        /* CIF PROCEDURECALL (251, 423), (70, 35) */
                        call bar
                        /* CIF comment (341, 423), (209, 53) */
                        comment 'not existing
but no error is expected
because the branch is not taken';
                    /* CIF ANSWER (576, 325), (70, 23) */
                    else:
                        /* CIF PROCEDURECALL (552, 368), (118, 35) */
                        call writeln('OK (1)');
                        /* CIF PROCEDURECALL (576, 423), (70, 35) */
                        call foo;
                endalternative;
                /* CIF alternative (321, 492), (70, 50) */
                alternative c_true;
                    /* CIF ANSWER (239, 562), (70, 23) */
                    (true):
                        /* CIF PROCEDURECALL (215, 605), (118, 35) */
                        call writeln('OK (2)');
                    /* CIF ANSWER (390, 562), (70, 23) */
                    (false):
                        /* CIF PROCEDURECALL (354, 605), (142, 35) */
                        call writeln('ERROR (2)');
                endalternative;
                /* CIF alternative (321, 656), (70, 50) */
                alternative c_true;
                    /* CIF ANSWER (312, 726), (86, 23) */
                    (true, false):
                        /* CIF PROCEDURECALL (296, 769), (118, 35) */
                        call writeln('OK (3)');
                endalternative;
                /* CIF alternative (321, 820), (70, 50) */
                alternative c_true;
                endalternative;
                /* CIF alternative (321, 890), (70, 50) */
                alternative c_true;
                    /* CIF ANSWER (321, 960), (70, 23) */
                    else:
                        /* CIF PROCEDURECALL (296, 1003), (118, 35) */
                        call writeln('OK (4)');
                endalternative;
                /* CIF PROCEDURECALL (296, 1054), (118, 35) */
                call writeln('OK (5)');
                /* CIF alternative (321, 1109), (70, 50) */
                alternative c_false;
                    /* CIF ANSWER (402, 1179), (70, 23) */
                    (false):
                        /* CIF PROCEDURECALL (377, 1222), (118, 35) */
                        call writeln('OK (6)');
                    /* CIF ANSWER (251, 1179), (70, 23) */
                    else:
                        /* CIF PROCEDURECALL (215, 1222), (142, 35) */
                        call writeln('ERROR (6)');
                endalternative;
                /* CIF alternative (314, 1273), (82, 50) */
                alternative otherTrue;
                    /* CIF ANSWER (239, 1343), (70, 23) */
                    (true):
                        /* CIF PROCEDURECALL (215, 1386), (118, 35) */
                        call writeln('OK (7)');
                    /* CIF ANSWER (390, 1343), (70, 23) */
                    (false):
                        /* CIF PROCEDURECALL (354, 1386), (142, 35) */
                        call writeln('ERROR (7)');
                endalternative;
                /* CIF NEXTSTATE (321, 1437), (70, 35) */
                NEXTSTATE wait;
            /* CIF state (681, 341), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state wait;
            endstate;
        endprocess foo;
    endblock;
endsystem;