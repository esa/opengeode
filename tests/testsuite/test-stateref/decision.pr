--  Regression test for PrimStateReference support.
--  A decision on the implicit `state` variable must compare the current state
--  and give the same answer in Ada, C and Rust.  The process alternates S1/S2
--  on each `impulse` and prints, from each state, whether `state = S1`.
/* CIF Keep Specific Geode ASNFilename 'dataview-uniq.asn' */
use Datamodel;

system Complexsdl;

   /* CIF Keep Specific Geode PARAMNAMES x_in */
   signal impulse (MyInteger);

   channel c
      from env to Complexsdl with impulse;
   endchannel;

   block Complexsdl;

      signalroute r
      from env to Complexsdl with impulse;
      connect c and r;

   /* CIF PROCESS (250, 150), (150, 75) */
process Complexsdl;
    /* CIF TEXT (1202, 0), (267, 140) */
    -- Text area for declarations and comments

    DCL tmp MyInteger;
    DCL result MyInteger;
    /* CIF ENDTEXT */
    /* CIF START (320, 21), (70, 35) */
    START;
        /* CIF NEXTSTATE (320, 71), (70, 35) */
        NEXTSTATE S1;
    /* CIF state (450, 21), (70, 35) */
    state S1;
        /* CIF input (434, 76), (101, 35) */
        input impulse(tmp);
            call writeln("S1: state=S1 is ", (state = S1));
            /* CIF decision (450, 131), (70, 50) */
            decision (state = S1);
                /* CIF ANSWER (682, 392), (70, 23) */
                (true):
                    TASK result := 1;
                /* CIF ANSWER (772, 392), (70, 23) */
                (false):
                    TASK result := 2;
            enddecision;
            call writeln("S1: result=", result);
            NEXTSTATE S2;
    endstate;
    /* CIF state (450, 21), (70, 35) */
    state S2;
        /* CIF input (434, 76), (101, 35) */
        input impulse(tmp);
            call writeln("S2: state=S1 is ", (state = S1));
            /* CIF decision (450, 131), (70, 50) */
            decision (state = S1);
                /* CIF ANSWER (682, 392), (70, 23) */
                (true):
                    TASK result := 10;
                /* CIF ANSWER (772, 392), (70, 23) */
                (false):
                    TASK result := 20;
            enddecision;
            call writeln("S2: result=", result);
            NEXTSTATE S1;
    endstate;
endprocess Complexsdl;
   endblock;
endsystem;
