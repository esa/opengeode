/* CIF PROCESS (150, 150), (150, 75) */
/* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
process challenge;
    state on;
    substructure
        in (via_toto);
        out (ret0,uncaught);
            state hello;
            substructure
                    /* CIF procedure (893, 436), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    procedure entry;
                        /* CIF START (178, 136), (70, 35) */
                        START;
                            /* CIF PROCEDURECALL (168, 186), (89, 35) */
                            call writeln('8');
                            /* CIF PROCEDURECALL (154, 236), (116, 35) */
                            call writeln('Hello!');
                            /* CIF return (195, 286), (35, 35) */
                            return ;
                    endprocedure;
                    /* CIF START (349, 133), (70, 35) */
                    START;
                        /* CIF NEXTSTATE (319, 183), (128, 35) */
                        NEXTSTATE wait_in_sub_hello;
                    /* CIF state (578, 147), (128, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state wait_in_sub_hello;
                    endstate;
            endsubstructure;
            state aggregation AggregNextToHello;
            substructure
                    state C;
                    substructure
                            /* CIF START (0, 0), (70, 35) */
                            START;
                                /* CIF NEXTSTATE (0, 50), (70, 35) */
                                NEXTSTATE CEH;
                            /* CIF state (116, 0), (70, 35) */
                            /* CIF Keep Specific Geode Partition 'default' */
                            state CEH;
                                /* CIF input (94, 55), (72, 35) */
                                input any_two;
                                    /* CIF PROCEDURECALL (86, 110), (89, 35) */
                                    call writeln('7');
                                    /* CIF NEXTSTATE (96, 165), (70, 35) */
                                    NEXTSTATE CEH;
                            endstate;
                    endsubstructure;
                    state D;
                    substructure
                            /* CIF START (80, 0), (70, 35) */
                            START;
                                /* CIF NEXTSTATE (80, 50), (70, 35) */
                                NEXTSTATE DEH;
                            /* CIF state (80, 0), (70, 35) */
                            /* CIF Keep Specific Geode Partition 'default' */
                            state DEH;
                            endstate;
                    endsubstructure;
                    /* CIF state (77, 147), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state D;
                    endstate;
                    /* CIF state (524, 0), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state C;
                    endstate;
            endsubstructure;
            /* CIF Keep Specific Geode Partition 'default' */
            /* CIF TEXT (528, 251), (312, 140) */
            dcl myresult T_UInt8 := 4;
            -- Use a variable with the same name as a variable
            -- in the outer scope, to check that code generators
            -- use the proper one
            dcl result T_UInt32 := 9;
            /* CIF ENDTEXT */
            /* CIF procedure (773, 143), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            procedure exit
            /* CIF comment (863, 119), (137, 83) */
            comment 'Special exit
procedure - called
automatically when
leaving the nested
state';
                /* CIF START (163, 119), (70, 35) */
                START;
                    /* CIF PROCEDURECALL (80, 169), (235, 35) */
                    call writeln('LEAVING the nested state');
                    /* CIF return (180, 219), (35, 35) */
                    return ;
            endprocedure;
            /* CIF procedure (453, 522), (86, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            procedure inner_proc;
                /* CIF Keep Specific Geode Partition 'default' */
                /* CIF TEXT (31, 41), (277, 140) */
                fpar in toto T_UInt8;
                
                -- Redefine a variable declared in outer scope
                dcl result t_Boolean := true;
                /* CIF ENDTEXT */
                /* CIF START (479, 97), (70, 35) */
                START;
                    /* CIF label (479, 147), (70, 35) */
                    hey_joe:
                    /* CIF PROCEDURECALL (465, 197), (96, 35) */
                    call writeln('10');
                    /* CIF task (461, 247), (104, 35) */
                    task result := false;
                    /* CIF label (479, 297), (70, 35) */
                    leaving:
                    /* CIF return (496, 347), (35, 35) */
                    return ;
            endprocedure;
            /* CIF procedure (772, 54), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            procedure entry
            /* CIF comment (858, 31), (157, 83) */
            comment 'Special Entry
procedure - called
automatically upon
entrance to the nested
state';
                /* CIF START (191, 78), (70, 35) */
                START;
                    /* CIF PROCEDURECALL (108, 128), (235, 35) */
                    call writeln('ENTERING NESTED STATE');
                    /* CIF return (208, 178), (35, 35) */
                    return ;
            endprocedure;
            /* CIF START (1402, 7), (71, 35) */
            START via_toto ;
                /* CIF PROCEDURECALL (1393, 57), (89, 35) */
                call writeln('3');
                /* CIF return (1421, 107), (35, 35) */
                return ret0;
            /* CIF START (1155, 8), (70, 35) */
            START;
                /* CIF PROCEDURECALL (1145, 58), (89, 35) */
                call writeln('6');
                /* CIF label (1143, 108), (92, 35) */
                inside_label:
                /* CIF PROCEDURECALL (1132, 158), (114, 35) */
                call pow(3,3, result);
                /* CIF decision (1155, 213), (70, 50) */
                decision result;
                    /* CIF ANSWER (1202, 283), (70, 23) */
                    (27):
                        /* CIF task (1187, 321), (98, 35) */
                        task myresult := 5;
                    /* CIF ANSWER (1082, 283), (70, 23) */
                    ELSE:
                        /* CIF return (1099, 326), (35, 35) */
                        return uncaught;
                enddecision;
                /* CIF label (1155, 377), (70, 35) */
                nslabel:
                /* CIF NEXTSTATE (1120, 427), (140, 35) */
                NEXTSTATE AggregNextToHello;
            /* CIF label (347, 324), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            connection to_label:
                /* CIF join (365, 374), (35, 35) */
                join another_floating;
            /* CIF End Label */
            endconnection;
            /* CIF label (727, 472), (122, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            connection another_floating:
                /* CIF PROCEDURECALL (744, 522), (89, 35) */
                call writeln('9');
                /* CIF task (739, 572), (98, 35) */
                task myresult := 1;
                /* CIF PROCEDURECALL (715, 622), (146, 35) */
                call inner_proc(myresult);
                /* CIF return (771, 672), (35, 35) */
                return ;
            /* CIF End Label */
            endconnection;
            /* CIF state (0, 0), (140, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state AggregNextToHello;
            endstate;
            /* CIF state (391, 0), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state hello;
                /* CIF input (391, 55), (70, 35) */
                input run;
                    /* CIF PROCEDURECALL (347, 111), (157, 35) */
                    call writeln('27 == ', result);
                    /* CIF task (371, 161), (109, 38) */
                    task myresult := 88,
result := 33;
                    /* CIF join (408, 214), (35, 35) */
                    join to_label;
            endstate;
            /* CIF state (1120, 427), (140, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state AggregNextToHello;
                /* CIF input (1150, 482), (72, 35) */
                input any_one;
                    /* CIF NEXTSTATE (1151, 537), (70, 35) */
                    NEXTSTATE hello;
            endstate;
    endsubstructure;
    state aggregation Safe;
    substructure
            state A;
            substructure
                    /* CIF START (217, 0), (70, 35) */
                    START;
                        /* CIF PROCEDURECALL (134, 55), (235, 35) */
                        call writeln('5: Parallel state A starting');
                        /* CIF NEXTSTATE (217, 105), (70, 35) */
                        NEXTSTATE HA;
                    /* CIF state (63, 0), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state HA;
                    endstate;
            endsubstructure;
            state B;
            substructure
                    /* CIF START (177, 0), (70, 35) */
                    START;
                        /* CIF PROCEDURECALL (91, 55), (243, 35) */
                        call writeln('5B: Parallel state B starting');
                        /* CIF NEXTSTATE (177, 105), (70, 35) */
                        NEXTSTATE BEH;
                    /* CIF state (10, 0), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state BEH;
                        /* CIF input (0, 55), (72, 35) */
                        input any_one;
                            /* CIF NEXTSTATE (1, 105), (70, 35) */
                            NEXTSTATE beh;
                    endstate;
            endsubstructure;
            /* CIF state (171, 147), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state B;
            endstate;
            /* CIF state (160, 0), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state A;
            endstate;
    endsubstructure;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (410, 0), (209, 140) */
    -- This system tests nested states
    
    dcl result T_uint32 :=0;
    /* CIF ENDTEXT */
    /* CIF START (21, 113), (68, 37) */
    START;
        /* CIF PROCEDURECALL (10, 165), (89, 35) */
        call writeln('1');
        /* CIF NEXTSTATE (20, 215), (70, 35) */
        NEXTSTATE OFF;
    /* CIF state (692, 140), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state on;
        /* CIF connect (499, 195), (0, 35) */
        connect ;
            /* CIF NEXTSTATE (464, 245), (70, 35) */
            NEXTSTATE off;
        /* CIF connect (580, 195), (0, 35) */
        connect ret0;
            /* CIF PROCEDURECALL (535, 250), (89, 35) */
            call writeln('4');
            /* CIF NEXTSTATE (545, 300), (70, 35) */
            NEXTSTATE Safe;
        /* CIF connect (798, 195), (70, 35) */
        connect uncaught
        /* CIF comment (888, 195), (141, 38) */
        comment 'Remove it to trigger
an error';
            /* CIF PROCEDURECALL (751, 250), (162, 35) */
            call writeln('UNEXPECTED');
            /* CIF NEXTSTATE (798, 300), (70, 35) */
            NEXTSTATE -;
    endstate;
    /* CIF state (236, 0), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state safe;
        /* CIF input (236, 55), (70, 35) */
        input run;
            /* CIF PROCEDURECALL (142, 110), (257, 35) */
            call writeln('5C Leaving two parallel states');
            /* CIF NEXTSTATE (236, 165), (70, 35) */
            NEXTSTATE on;
    endstate;
    /* CIF state (20, 215), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state OFF;
        /* CIF input (20, 270), (70, 35) */
        input run;
            /* CIF PROCEDURECALL (10, 320), (89, 35) */
            call writeln('2');
            /* CIF NEXTSTATE (0, 371), (110, 35) */
            NEXTSTATE on via via_toto
            /* CIF comment (128, 371), (197, 35) */
            comment 'Enter substate via entry point';
    endstate;
endprocess challenge;