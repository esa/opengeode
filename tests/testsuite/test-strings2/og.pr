system og;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (279, 258), (267, 140) */
    -- Text area for declarations and comments
    
    use dv comment 'dataview-uniq.asn';
    
    signal run;
    /* CIF ENDTEXT */
    channel c
        from env to og with run;
    endchannel;
    block og;
        signalroute r
            from env to og with run;
        connect c and r;
        /* CIF PROCESS (253, 105), (150, 75) */
        /* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
        process og;
            /* CIF Keep Specific Geode Partition 'default' */
            /* CIF TEXT (0, 33), (267, 140) */
            -- Text area for declarations and comments
            
            
            dcl octstr OutStr := 'world';
            dcl ia5 TextString := 'hello';
            dcl fixed FixedOctetString := 'FoO';
            dcl fixedIA5 FixedIA5String := 'BaR';
            /* CIF ENDTEXT */
            /* CIF START (284, 274), (70, 35) */
            START;
                /* CIF PROCEDURECALL (241, 329), (154, 35) */
                call writeln(ia5, " ", octstr)
                /* CIF comment (416, 329), (89, 35) */
                comment 'hello world';
                /* CIF PROCEDURECALL (228, 384), (180, 35) */
                call writeln(fixed, " ", fixedIA5)
                /* CIF comment (430, 384), (73, 35) */
                comment 'FoO BaR';
                /* CIF PROCEDURECALL (199, 434), (238, 35) */
                call writeln(if true then ia5 else octstr fi)
                /* CIF comment (458, 434), (70, 35) */
                comment 'hello';
                /* CIF PROCEDURECALL (200, 484), (236, 35) */
                call writeln(if true then "you" else ia5 fi)
                /* CIF comment (457, 484), (70, 35) */
                comment 'you';
                /* CIF PROCEDURECALL (188, 539), (261, 35) */
                call writeln(if true then "hello" else octstr fi)
                /* CIF comment (469, 539), (70, 35) */
                comment 'hello';
                /* CIF PROCEDURECALL (183, 594), (271, 35) */
                call writeln(if true then "world" else "hello" fi)
                /* CIF comment (474, 594), (70, 35) */
                comment 'world';
                /* CIF PROCEDURECALL (187, 649), (263, 35) */
                call writeln(if true then fixed else fixedia5 fi)
                /* CIF comment (470, 649), (70, 35) */
                comment 'FoO';
                /* CIF PROCEDURECALL (159, 704), (319, 35) */
                call writeln(if true then fixedia5 else "Not expected" fi)
                /* CIF comment (498, 704), (70, 35) */
                comment 'BaR';
                /* CIF NEXTSTATE (284, 754), (70, 35) */
                NEXTSTATE wait;
            /* CIF state (165, 194), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state wait;
            endstate;
        endprocess og;
    endblock;
endsystem;