/* CIF PROCESS (250, 150), (150, 75) */
/* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
process Testbs;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (933, 100), (182, 140) */
    dcl mybs BS := '101010101010'B;
    
    dcl mybs2 BS := {bit0, bit11};
    
    dcl slice BS := '000000000000'B;
    
    dcl abit T_Boolean;
    /* CIF ENDTEXT */
    /* CIF procedure (1069, 431), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    procedure PrintBS;
        /* CIF Keep Specific Geode Partition 'default' */
        /* CIF TEXT (64, 70), (170, 140) */
        fpar in inp BS;
        /* CIF ENDTEXT */
        /* CIF START (440, 126), (70, 35) */
        START;
            /* CIF task (339, 181), (272, 53) */
            task for idx in range(length(inp)):
   call write(if inp(idx) then "1" else "0" fi);
endfor;
            /* CIF return (457, 254), (35, 35) */
            return ;
    endprocedure;
    /* CIF START (650, 32), (70, 35) */
    START;
        /* CIF PROCEDURECALL (560, 88), (249, 35) */
        call write("lit should be 101010101010: ");
        /* CIF PROCEDURECALL (631, 143), (106, 35) */
        call PrintBS(mybs);
        /* CIF PROCEDURECALL (580, 193), (208, 35) */
        call writeln(" - size: ", length(mybs));
        /* CIF PROCEDURECALL (554, 248), (260, 35) */
        call write("named then set: ");
        /* CIF PROCEDURECALL (629, 298), (111, 35) */
        call Printbs(mybs2);
        /* CIF PROCEDURECALL (644, 353), (80, 35) */
        call write("  ");
        /* CIF task (630, 408), (109, 35) */
        task mybs2 := {bit3, bit11};
        /* CIF task (625, 463), (119, 35) */
        task mybs2(8) := true;
        task mybs2(1) := true;
        /* CIF task (700, 500), (150, 35) */
        task slice := mybs(2, 5);
        /* CIF PROCEDURECALL (629, 513), (111, 35) */
        call Printbs(mybs2);
        /* CIF PROCEDURECALL (638, 568), (92, 35) */
        call write("  slice should be 1010: ");
        call Printbs(slice);
        call writeln("  ");
        /* CIF NEXTSTATE (650, 618), (70, 35) */
        NEXTSTATE Wait;
    /* CIF state (450, 10), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Wait;
    endstate;
endprocess Testbs;