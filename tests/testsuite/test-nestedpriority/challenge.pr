/* CIF PROCESS (150, 150), (150, 75) */
/* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
process challenge;
    state well;
    substructure
            /* CIF START (109, 64), (70, 35) */
            START;
                /* CIF NEXTSTATE (109, 119), (70, 35) */
                NEXTSTATE in_well;
            /* CIF state (109, 119), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state in_well;
                /* CIF input (109, 174), (70, 35) */
                input run;
                    /* CIF NEXTSTATE (109, 229), (70, 35) */
                    NEXTSTATE in_well;
            endstate;
    endsubstructure;
    state nested;
    substructure
            state nested_1;
            substructure
                    /* CIF procedure (112, 183), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    procedure entry;
                        /* CIF START (105, 54), (70, 35) */
                        START;
                            /* CIF PROCEDURECALL (45, 104), (189, 35) */
                            call writeln('entering nested_1');
                            /* CIF return (122, 154), (35, 35) */
                            return ;
                    endprocedure;
                    /* CIF procedure (104, 101), (70, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    procedure exit;
                        /* CIF START (198, 116), (70, 35) */
                        START;
                            /* CIF PROCEDURECALL (152, 166), (161, 35) */
                            call writeln('exit nested_1');
                            /* CIF return (215, 216), (35, 35) */
                            return ;
                    endprocedure;
                    /* CIF START (245, 55), (70, 35) */
                    START;
                        /* CIF NEXTSTATE (241, 105), (77, 35) */
                        NEXTSTATE nested_2;
                    /* CIF state (283, 165), (77, 35) */
                    /* CIF Keep Specific Geode Partition 'default' */
                    state nested_2;
                        /* CIF input (287, 220), (70, 35) */
                        input run;
                            /* CIF PROCEDURECALL (272, 270), (99, 35) */
                            call writeln('OK');
                            /* CIF NEXTSTATE (287, 320), (70, 35) */
                            NEXTSTATE -;
                    endstate;
            endsubstructure;
            /* CIF procedure (342, 134), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            procedure entry;
                /* CIF START (121, 85), (70, 35) */
                START;
                    /* CIF PROCEDURECALL (68, 135), (175, 35) */
                    call writeln('entering nested');
                    /* CIF return (138, 185), (35, 35) */
                    return ;
            endprocedure;
            /* CIF procedure (334, 58), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            procedure exit;
                /* CIF START (76, 53), (70, 35) */
                START;
                    /* CIF PROCEDURECALL (37, 103), (147, 35) */
                    call writeln('exit nested');
                    /* CIF return (93, 153), (35, 35) */
                    return ;
            endprocedure;
            /* CIF START (136, 68), (70, 35) */
            START;
                /* CIF NEXTSTATE (132, 118), (77, 35) */
                NEXTSTATE nested_1;
            /* CIF state (132, 118), (77, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state nested_1;
                /* CIF input (135, 173), (70, 35) */
                input go_off;
                    /* CIF return (152, 223), (35, 35) */
                    return ;
            endstate;
    endsubstructure;
    /* CIF START (93, 76), (68, 37) */
    START;
        /* CIF NEXTSTATE (92, 128), (70, 35) */
        NEXTSTATE nested;
    /* CIF state (0, 233), (105, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state Iamdoing:well;
        /* CIF input (17, 288), (70, 35) */
        input run;
            /* CIF NEXTSTATE (17, 343), (70, 35) */
            NEXTSTATE -;
    endstate;
    /* CIF state (92, 128), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state nested;
        /* CIF input (146, 183), (70, 35) */
        input run;
            /* CIF PROCEDURECALL (129, 233), (105, 35) */
            call writeln('FAIL');
            /* CIF NEXTSTATE (146, 283), (70, 35) */
            NEXTSTATE -;
        /* CIF connect (52, 183), (0, 35) */
        connect ;
            /* CIF NEXTSTATE (0, 233), (105, 35) */
            NEXTSTATE Iamdoing:well;
    endstate;
    /* CIF state (390, 131), (70, 35) */
    /* CIF Keep Specific Geode Partition 'default' */
    state well;
    endstate;
endprocess challenge;