system og;
    signal dummy;
    /* CIF Keep Specific Geode Partition 'default' */
    /* CIF TEXT (159, 221), (267, 140) */
    -- Text area for declarations and comments
    
    use dv comment 'dataview-uniq.asn';
    
    signal dd;
    signal we;
    /* CIF ENDTEXT */
    channel c1
        /* CIF Keep Specific Geode ROUTE (225, 86) (-75, 86) */
        from env to og with dd;
        from og to env with we;
    endchannel;
    block og;
        signalroute r1
            /* CIF Keep Specific Geode ROUTE (225, 86) (-75, 86) */
            from env to og with dd;
            from og to env with we;
        connect c1 and r1;
        /* CIF PROCESS (225, 49), (150, 75) */
        /* CIF Keep Specific Geode _REQSERVER_ 'https://gitlab.esa.int/taste/demo' */
        process og;
            /* CIF Keep Specific Geode Partition 'default' */
            /* CIF TEXT (57, 58), (415, 203) */
            dcl smallsigned ByteSigned := '70'H; -- Type check is done here
            dcl smallunsigned ByteUnsigned := leftBit;  -- Ref to ASN.1 constant
            
            dcl longsigned LargeSigned := 800;
            dcl longunsigned LargeUnsigned := 'FFFF'H;
            
            dcl boundedstring fixedOctStr := 'FFFFFFFFFF'H; 
            dcl bs2 fixedOctStr := 'FF00FF00FF'H;
            
            dcl unboundedstring VarOctStr := 'ABCD'H;
            
            dcl boundedbools FixedSeqBool := { true, true, false, false };
            dcl unboundedbools VarSeqBool := { true, false };
            /* CIF ENDTEXT */
            /* CIF START (567, 199), (70, 35) */
            START;
                /* CIF task (532, 254), (139, 35) */
                task smallsigned := '70'H
                /* CIF comment (690, 254), (125, 35) */
                comment 'range checked ok';
                /* CIF PROCEDURECALL (461, 311), (280, 35) */
                call writeln('Test of various bitwise operations');
                /* CIF task (465, 366), (273, 35) */
                task longunsigned := longunsigned and fullbyte;
                /* CIF PROCEDURECALL (475, 421), (253, 35) */
                call writeln('should be 255:', longunsigned);
                /* CIF task (469, 471), (264, 35) */
                task longunsigned := longunsigned or  'FFFF'H;
                /* CIF task (471, 526), (260, 35) */
                task longunsigned := longunsigned + '03'H - 3;
                /* CIF decision (550, 576), (103, 50) */
                decision longunsigned;
                    /* CIF ANSWER (530, 646), (70, 23) */
                    (0:'FF'H):
                    /* CIF ANSWER (612, 646), (86, 38) */
                    (> 'FF'H + 1,
256):
                enddecision;
                /* CIF task (472, 700), (259, 35) */
                task boundedstring := boundedstring xor bs2;
                /* CIF task (395, 755), (412, 53) */
                task for each in range(length(boundedstring)):
   call write(if boundedstring(each) = 'FF'H then "FF " else "00 " fi);
endfor;
                /* CIF PROCEDURECALL (561, 828), (81, 35) */
                call writeln('');
                /* CIF task (485, 883), (232, 38) */
                task smallunsigned := '00'H,
smallunsigned := not smallunsigned;
                /* CIF PROCEDURECALL (521, 941), (160, 35) */
                call writeln(smallunsigned)
                /* CIF comment (702, 941), (70, 35) */
                comment '255';
                /* CIF NEXTSTATE (567, 991), (70, 35) */
                NEXTSTATE wait;
            /* CIF state (511, 123), (70, 35) */
            /* CIF Keep Specific Geode Partition 'default' */
            state wait;
            endstate;
        endprocess og;
    endblock;
endsystem;